# Copy to .env for local development. .env is git-ignored.
# Never put Microsoft tenant credentials or certificates in this file;
# profile credentials are mounted into the broker only (threat-model §4.3).

POSTGRES_USER=clw
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=clw
# Non-default ports so this stack can run beside the legacy compose stack (5432/6379).
POSTGRES_PORT=5433

REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6380

# --- api, broker and runner (`docker compose --profile app up`) ---
# Each component gets its own least-privileged database role. Create them, with
# exactly these users and passwords, by running `clw db-provision-roles` with
# the owner's DATABASE_URL (see docs/runbooks/dev-tenant-setup.md).
# CLW_API_DATABASE_URL=postgresql+asyncpg://clw_api:<password>@postgres:5432/clw
# CLW_BROKER_DATABASE_URL=postgresql+asyncpg://clw_broker:<password>@postgres:5432/clw
# CLW_RUNNER_DATABASE_URL=postgresql+asyncpg://clw_runner:<password>@postgres:5432/clw
# Profile app registration (names the dev tenant's app; the certificate itself
# lives outside the repo, in CLW_PROFILE_CERT_DIR, mounted into the broker only).
# CLW_PROFILE_DIRREAD_CLIENT_ID=
# CLW_PROFILE_DIRREAD_CERT_THUMBPRINT=
# Agent profile app (v0.1): deploy/test-tenant/setup.ps1 prints both values.
# CLW_PROFILE_AGENTRO_CLIENT_ID=
# CLW_PROFILE_AGENTRO_CERT_THUMBPRINT=
# CLW_PROFILE_CERT_DIR=
# CLW_TASK_IMAGE=clw-task:phase1
# Graph facade (SD-041): the directory `clw facade-ca-init --out <dir>` wrote.
# Its leaf.crt and leaf.key are mounted into the facade proxy only; keep ca.key offline.
# CLW_FACADE_CERT_DIR=./secrets/facade

# --- dev tenant (Task 17C): real Entra, test accounts only ---
# Setup steps: docs/runbooks/dev-tenant-setup.md. Values go in .env only;
# never paste the client secret or the private key anywhere else.
# Tenant ID (not secret). Read by the dev-tenant harness only; the app itself
# takes the tenant from the tenants table, never from configuration.
# CLW_DEV_TENANT_ID=
# Sign-in app (api; openid profile only, no Graph permissions; SD-029).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# POST_LOGIN_PATH=/tasks
# SESSION_JWT_SECRET=
# Profile app (broker). The key path is for a broker run on the host; in
# compose the broker reads it from CLW_PROFILE_CERT_DIR instead.
# CLW_PROFILE_DIRREAD_CERT_PATH=./secrets/profiles/directory-read-auditlog-read.pem
# Dev-tenant tests (`CLW_RUN_TENANT_TESTS=1 uv run pytest -m tenant`): object IDs of
# the test accounts (not secrets). A test skips while its ID is unset.
# CLW_DEV_TEST_ACTIVE_ID=
# CLW_DEV_TEST_NEVER_ID=
# CLW_DEV_TEST_DISABLED_ID=
